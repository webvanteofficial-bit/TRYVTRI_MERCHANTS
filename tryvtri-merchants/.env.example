# Supabase project (server-side only - never expose the secret key in the browser)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string (used to sign login sessions)
JWT_SECRET=change-me-to-a-long-random-string

# Only needed for 'npm run db:migrate' (schema bootstrap)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:6543/postgres