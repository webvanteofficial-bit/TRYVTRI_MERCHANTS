# --- Vercel: only ONE variable is required -------------------------------
# Either name works (SUPABASE_SECRET_KEY preferred). Values are identical.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional - auto-derived from the key above if unset.
# JWT_SECRET=change-me-to-a-long-random-string

# Optional - auto-detected (REST URL is derived from project ref).
# Accepts the dashboard URL or the Postgres connection string.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Only needed for 'npm run db:migrate' (schema bootstrap)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:6543/postgres